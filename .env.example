# App
PORT=3000

# Database (PostgreSQL - see docker-compose.yml)
# DB_PORT=5433 en el host para no chocar con un Postgres nativo ya escuchando en 5432
DB_HOST=localhost
DB_PORT=5433
DB_USER=aguafix
DB_PASSWORD=aguafix
DB_NAME=aguafix

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=1h

# SMTP (nodemailer) - e.g. Gmail SMTP with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=AguaFix <your-smtp-user@gmail.com>

# Fixed maintenance crew address that receives new-report notifications
MAIL_CREW_ADDRESS=mykechvz@gmail.com

# AWS S3 (fotos de las fugas) - usuario IAM con permiso s3:PutObject sobre el bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name

# Usuario de Docker Hub (lo usa compose.yaml para bajar la imagen publicada)
DOCKER_USER=your-dockerhub-user
